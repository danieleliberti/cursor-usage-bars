{
  "name": "cursor-usage-bars",
  "displayName": "Cursor Usage Bars",
  "description": "Status bar sparkline of Cursor spend with 7D / 15D / 30D popup range. Auto auth from Cursor login. Works in Local and Remote SSH.",
  "version": "0.4.7",
  "publisher": "danieleliberti",
  "author": {
    "name": "Daniele Liberti"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#FCFCFC",
    "theme": "light"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=20.19.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "cursor",
    "usage",
    "status bar",
    "spend",
    "tokens",
    "remote",
    "ssh"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cursorUsageBars.refresh",
        "title": "Cursor Usage Bars: Refresh"
      },
      {
        "command": "cursorUsageBars.openDashboard",
        "title": "Cursor Usage Bars: Open Usage Dashboard"
      },
      {
        "command": "cursorUsageBars.authStatus",
        "title": "Cursor Usage Bars: Auth Status"
      },
      {
        "command": "cursorUsageBars.setToken",
        "title": "Cursor Usage Bars: Set Access Token (fallback)"
      },
      {
        "command": "cursorUsageBars.clearToken",
        "title": "Cursor Usage Bars: Clear Access Token"
      },
      {
        "command": "cursorUsageBars.chooseDayRange",
        "title": "Cursor Usage Bars: Choose Day Range (7D / 15D / 30D)"
      },
      {
        "command": "cursorUsageBars.setDayRange",
        "title": "Cursor Usage Bars: Set Day Range"
      }
    ],
    "configuration": {
      "title": "Cursor Usage Bars",
      "properties": {
        "cursorUsageBars.apiBaseUrl": {
          "type": "string",
          "default": "https://api2.cursor.sh",
          "description": "HTTPS base URL for Cursor usage API."
        },
        "cursorUsageBars.pollIntervalSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 60,
          "description": "Background refresh interval in seconds (minimum 60)."
        },
        "cursorUsageBars.dayRange": {
          "type": "number",
          "enum": [7, 15, 30],
          "default": 7,
          "description": "Default day range for the status-bar popup (7, 15, or 30). Overridden when you pick a range in the popup."
        },
        "cursorUsageBars.manualMonthlyLimitDollars": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Override monthly limit in USD. 0 = use Cursor-reported limit."
        },
        "cursorUsageBars.dashboardUrl": {
          "type": "string",
          "default": "https://cursor.com/dashboard/usage",
          "description": "URL opened when clicking the status bar item."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run clean && npm run compile",
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish:marketplace": "vsce publish",
    "publish:openvsx": "ovsx publish"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "ovsx": "^0.10.1",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "sql.js": "^1.11.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/danieleliberti/cursor-usage-bars.git"
  },
  "homepage": "https://github.com/danieleliberti/cursor-usage-bars",
  "bugs": "https://github.com/danieleliberti/cursor-usage-bars/issues"
}
